{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "name": "YouTube Transcript Downloader",
  "version": "0.1.0",
  "description": "Download and copy transcripts from YouTube videos.",
  "icons": {
    "16": "../icons/icon-512.png",
    "32": "../icons/icon-512.png",
    "48": "../icons/icon-512.png",
    "128": "../icons/icon-512.png",
    "512": "../icons/icon-512.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite", "alarms"],
  "host_permissions": ["https://www.youtube.com/*"],
  "chromium:background": {
    "service_worker": "background/entry.ts"
  },
  "firefox:background": {
    "scripts": ["background/entry.ts"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/entry.ts"],
      "run_at": "document_start"
    }
  ],
  "chromium:action": {
    "default_title": "YouTube Transcript Downloader",
    "default_icon": "../icons/icon-512.png",
    "default_popup": "popup/index.html"
  },
  "firefox:browser_action": {
    "default_title": "YouTube Transcript Downloader",
    "default_icon": "../icons/icon-512.png",
    "default_popup": "popup/index.html"
  },
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "youtube-transcript-downloader@norbertfila.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
