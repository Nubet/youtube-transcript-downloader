{
  "name": "youtube-transcript-downloader",
  "version": "0.1.2",
  "private": true,
  "description": "Download and copy transcripts from YouTube videos.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "extension dev --browser chrome",
    "dev:firefox": "extension dev --browser firefox",
    "preview:chrome": "extension preview --browser chrome",
    "preview:firefox": "extension preview --browser firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "package": "npm run build:chrome -- --zip && npm run build:firefox -- --zip",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node scripts/check-builds.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "extension": "^4.1.38",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.13.0"
}
